                else null
            end, 2
        )                                                                       as gross_margin_pct,
        stock_qty::integer                                                      as stock_qty,
        case when is_active = 1 then true else false end                        as is_active,
        created_at::date                                                        as created_at
    from source
    where product_id is not null
      and unit_price > 0
)

